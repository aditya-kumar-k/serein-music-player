{
  "name": "music-player",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:www": "node build-mobile.js",
    "build:mobile": "node build-mobile.js && npx cap sync android",
    "build:apk": "node package-apk.js",
    "deploy:phone": "node package-apk.js --install",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "build:release": "node package-apk.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@electron/remote": "^2.1.3",
    "@indic-transliteration/sanscript": "^1.3.3",
    "chokidar": "^3.5.3",
    "electron": "^28.0.0",
    "howler": "^2.2.3",
    "jsmediatags": "^3.9.7",
    "music-metadata": "^7.14.0"
  }
}
